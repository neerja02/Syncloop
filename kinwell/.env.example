# ---------------------------------------------------------------------------
# Kinwell environment. EVERYTHING is optional for local development:
# with no values set, Kinwell runs on embedded Postgres (PGlite) with demo data
# and development adapters for AI, OCR, weather, provider search and email.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Product scope -----------------------------------------------------------
# The doctor portal is outside the patient-first MVP. Set to true to re-enable it.
ENABLE_DOCTOR_PORTAL=false

# --- Security (REQUIRED in production) --------------------------------------
# Long random strings, e.g. `openssl rand -base64 48`
SESSION_SECRET=
STORAGE_SIGNING_SECRET=
# Bearer token for /api/cron/reminders
CRON_SECRET=

# --- Database ---------------------------------------------------------------
# Leave empty to use embedded PGlite in ./.data/pglite (development only).
# Supabase: Project Settings → Database → Connection string (use the pooler URL for serverless).
DATABASE_URL=
DATABASE_POOL_SIZE=10
# DATABASE_SSL=false            # for local Postgres without TLS
# PGLITE_DATA_DIR=.data/pglite
# AUTO_SEED_DEMO=false          # don't seed demo data on first run

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=health-files

# --- Auth -------------------------------------------------------------------
# local = built-in email/password + magic link (works out of the box)
# supabase = Supabase Auth adapter (see lib/security/auth-provider.ts)
AUTH_PROVIDER=local
# OAuth buttons appear only when these are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- File storage -----------------------------------------------------------
# local = ./.data/storage (private, served via signed /api/files URLs) | supabase
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage

# --- AI ---------------------------------------------------------------------
# mock | anthropic | openai   (missing keys automatically fall back to mock)
AI_PROVIDER=mock
# Optional model override (default for anthropic: claude-opus-5-5)
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# mock | openai   (openai = text-embedding-3-small; re-index knowledge after switching)
EMBEDDING_PROVIDER=mock

# --- Document recognition (OCR) ---------------------------------------------
# local | azure | google | aws
OCR_PROVIDER=local
GOOGLE_DOCUMENT_AI_KEY=
GOOGLE_DOCUMENT_AI_PROCESSOR=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# --- Terminology ------------------------------------------------------------
# local | rxnav  (NLM RxNav needs no key)
MEDICATION_TERMINOLOGY_PROVIDER=local
MEDICATION_TERMINOLOGY_API_KEY=
# local | snomed
CLINICAL_TERMINOLOGY_PROVIDER=local
CLINICAL_TERMINOLOGY_API_KEY=

# --- Weather, maps & provider search ----------------------------------------
# mock | open-meteo (free, no key)
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
# mock | google (Places API)
PROVIDER_SEARCH_PROVIDER=mock
MAPS_API_KEY=

# --- Email & notifications --------------------------------------------------
# dev-mailbox (view at /dev/mailbox) | resend
EMAIL_PROVIDER=dev-mailbox
RESEND_API_KEY=
EMAIL_FROM="Kinwell <no-reply@example.com>"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Show the demo-account hint on the login page in production builds
SHOW_DEMO_ACCOUNTS=false
