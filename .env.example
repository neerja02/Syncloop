# ElevenLabs API key (Developers → API keys). Kept on the server only, never sent to the browser.
ELEVENLABS_API_KEY=
# The Sister Nia agent already created in your ElevenLabs account
ELEVENLABS_AGENT_ID=agent_8401m4vje8w3fdjajg1v11y7z1ef
# API server port (the Vite dev server proxies /api to it)
PORT=8787
# Optional. Signs the login cookie. Leave empty and one is generated and kept in server/data/session-secret.
SESSION_SECRET=

# SOS button: automatic emergency phone call + WhatsApp to the emergency contacts (Twilio).
# Leave empty and the SOS screen opens the phone dialer and WhatsApp instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number that can call India, e.g. +1415xxxxxxx
TWILIO_CALL_FROM=
# Your Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (the sandbox number while testing)
TWILIO_WHATSAPP_FROM=

# Optional. "Continue with Google" on the login page. Create an OAuth client (Web application) in Google Cloud,
# and add http://localhost:5173/api/auth/google/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the app runs at another address, e.g. https://nia.example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
